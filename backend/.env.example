# Database Connection URL (replace with your actual connection string)
# Example for PostgreSQL: DATABASE_URL="postgresql://user:password@host:port/database?schema=public"
# Example for SQLite: DATABASE_URL="file:./dev.db"
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/skillsphere?schema=public"

# JWT Configuration
JWT_SECRET="REPLACE_THIS_WITH_A_VERY_STRONG_SECRET_KEY" # Use a long, random string
JWT_EXPIRES_IN="1d" # Example: 1 day expiration

# Server Port (Optional, defaults usually work)
# PORT=3000