// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUM ADDED ---
enum TeamRole {
  LEADER
  MEMBER
}
// --- END ENUM ---

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownedTeams    Team[]             @relation("OwnedTeams")
  memberships   TeamMembership[]
  authoredSkills Skill[]           @relation("AuthoredSkills")
  progressLogs  SkillProgressLog[]
  authProviders AuthProvider[]
  categories    Category[] // Keep categories personal
  tags          Tag[]      // Keep tags personal
}

model AuthProvider {
  id           Int    @id @default(autoincrement())
  userId       Int
  providerName String
  providerId   String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([providerName, providerId])
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String
  ownerId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User             @relation("OwnedTeams", fields: [ownerId], references: [id], onDelete: Cascade)
  members   TeamMembership[]
  skills    Skill[]

  @@unique([ownerId, name]) // Team name unique per owner
}

model TeamMembership {
  userId    Int
  teamId    Int
  role      TeamRole @default(MEMBER) // <-- USE ENUM HERE
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
}

model Skill {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  categoryId      Int?     // Foreign key to user's personal Category
  currentScore    Int      @default(0)
  maxScore        Int      @default(10)
  ratingScaleType String   @default("numeric")
  createdAt       DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId          Int?     // Nullable: For personal skills
  teamId          Int?     // Nullable: For team skills

  user            User?    @relation("AuthoredSkills", fields: [userId], references: [id], onDelete: Cascade)
  team            Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull) // Category is personal
  progressLogs    SkillProgressLog[]
  goals           Goal[]   // TODO: Define goal ownership (personal or team?)
  tags            SkillTag[] // Tags applied are personal via SkillTag

  @@unique([userId, name])
  @@unique([teamId, name])
}

model Category { // Personal Category
  id     Int     @id @default(autoincrement())
  userId Int
  name   String
  skills Skill[] // Skills using this category (can be personal or team skills)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, name])
}

model SkillProgressLog {
  id                Int      @id @default(autoincrement())
  skillId           Int
  userId            Int      // User who logged the progress
  timestamp         DateTime @default(now())
  score             Int
  notes             String?
  timeSpentMinutes  Int?
  createdAt         DateTime @default(now())

  skill             Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence          SkillEvidence[]
}

model SkillEvidence {
  id          Int      @id @default(autoincrement())
  logId       Int
  type        String
  value       String
  description String?
  createdAt   DateTime @default(now())
  log         SkillProgressLog @relation(fields: [logId], references: [id], onDelete: Cascade)
}

model Goal { // TODO: Revisit goal ownership if implementing
  id           Int      @id @default(autoincrement())
  skillId      Int
  targetScore  Int
  targetDate   DateTime?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  skill        Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model Tag { // Personal Tag
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  skills    SkillTag[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, name])
}

model SkillTag { // Links a user's personal tag to a skill (personal or team)
  skillId   Int
  tagId     Int
  assignedAt DateTime @default(now())
  // assignedBy could be userId to track who added the personal tag
  // assignedBy String?

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([skillId, tagId])
}