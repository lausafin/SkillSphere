// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Or "mysql", "sqlite", etc.
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  passwordHash  String
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  skills        Skill[]
  categories    Category[]
  tags          Tag[]
  authProviders AuthProvider[]
}

model AuthProvider {
  id           Int    @id @default(autoincrement())
  userId       Int
  providerName String // e.g., 'google', 'github'
  providerId   String // User's ID from the provider
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerName, providerId])
}

model Skill {
  id              Int      @id @default(autoincrement())
  userId          Int
  name            String
  description     String?
  categoryId      Int?     // Nullable Foreign Key
  currentScore    Int      @default(0)
  maxScore        Int      @default(10)
  ratingScaleType String   @default("numeric")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull) // Set categoryId to NULL if Category is deleted
  progressLogs    SkillProgressLog[]
  goals           Goal[]
  tags            SkillTag[] // Many-to-many relation through SkillTag

  @@unique([userId, name])
}

model Category {
  id     Int     @id @default(autoincrement())
  userId Int
  name   String
  skills Skill[] // Relation back to skills
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model SkillProgressLog {
  id                Int      @id @default(autoincrement())
  skillId           Int
  timestamp         DateTime @default(now())
  score             Int
  notes             String?
  timeSpentMinutes  Int?
  createdAt         DateTime @default(now())

  skill             Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  evidence          SkillEvidence[]
}

model SkillEvidence {
  id          Int      @id @default(autoincrement())
  logId       Int
  type        String   // 'link', 'file', 'text'
  value       String
  description String?
  createdAt   DateTime @default(now())

  log SkillProgressLog @relation(fields: [logId], references: [id], onDelete: Cascade)
}

model Goal {
  id           Int      @id @default(autoincrement())
  skillId      Int
  targetScore  Int
  targetDate   DateTime?
  status       String   @default("active") // 'active', 'achieved', 'missed'
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model Tag {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  skills    SkillTag[] // Relation through join table
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model SkillTag {
  skillId   Int
  tagId     Int
  assignedAt DateTime @default(now())
  // assignedBy String // Optional: Track who assigned

  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([skillId, tagId]) // Composite primary key
}